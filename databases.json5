// Stricter update policy for database images. See README.md for the full reasoning.
//
// Why: an app update that breaks is fixed by reverting the PR. A database update often
// rewrites its data on disk when it starts, so reverting the image tag leaves an old
// version that can't read the data, and only a backup restore gets you back.
// For most databases a "minor" bump (MariaDB 11.4 -> 11.8, MySQL 8.0 -> 8.4) is a new
// release series, so only patches are automerged. PostgreSQL is the exception: its
// X.Y -> X.Z releases are bug fixes with the same on-disk format.
//
// The policy lives here, shared by every repo. App-specific limits (e.g. the highest
// MariaDB version an app supports) belong in that app's repo.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Must be extended AFTER autoMerge.json5 so these rules override it.
  packageRules: [
    {
      description: "Databases: label, wait longer and keep patch separate from minor so patches can still automerge",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/(^|/)(postgres|postgresql|postgis|pgvector|timescaledb|timescaledb-ha)$/",
        "/(^|/)(mariadb|mysql|percona-server|mssql/server)$/",
        "/(^|/)(mongo|mongodb-community-server|percona-server-mongodb)$/",
        "/(^|/)(redis|redis-stack-server|valkey)$/",
        "/(^|/)(elasticsearch|opensearch|clickhouse-server|influxdb|cassandra|couchdb|neo4j)$/",
      ],
      addLabels: ["database"],
      separateMinorPatch: true,
      minimumReleaseAge: "7 days",
    },
    {
      description: "Databases: minor bumps are new release series (MariaDB 11.4 -> 11.8, MySQL 8.0 -> 8.4, Mongo 7.0 -> 7.3...), review them",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/(^|/)(postgres|postgresql|postgis|pgvector|timescaledb|timescaledb-ha)$/",
        "/(^|/)(mariadb|mysql|percona-server|mssql/server)$/",
        "/(^|/)(mongo|mongodb-community-server|percona-server-mongodb)$/",
        "/(^|/)(redis|redis-stack-server|valkey)$/",
        "/(^|/)(elasticsearch|opensearch|clickhouse-server|influxdb|cassandra|couchdb|neo4j)$/",
      ],
      matchUpdateTypes: ["minor"],
      automerge: false,
    },
    {
      description: "PostgreSQL: X.Y -> X.Z is a bug-fix release with the same on-disk format, safe to automerge",
      matchDatasources: ["docker"],
      matchPackageNames: ["/(^|/)(postgres|postgresql|postgis)$/"],
      matchUpdateTypes: ["minor"],
      automerge: true,
    },
    {
      description: "Databases: majors need a data migration (dump/restore, pg_upgrade...), only open a PR when ticked in the dashboard",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/(^|/)(postgres|postgresql|postgis|pgvector|timescaledb|timescaledb-ha)$/",
        "/(^|/)(mariadb|mysql|percona-server|mssql/server)$/",
        "/(^|/)(mongo|mongodb-community-server|percona-server-mongodb)$/",
        "/(^|/)(redis|redis-stack-server|valkey)$/",
        "/(^|/)(elasticsearch|opensearch|clickhouse-server|influxdb|cassandra|couchdb|neo4j)$/",
      ],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
  ],
}
