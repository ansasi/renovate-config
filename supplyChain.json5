// Package registries (npm, PyPI, crates.io and Go modules): the 7-day wait from releaseAge.json5,
// also for their indirect dependencies where the package manager supports it, and never an
// update without a release date.
//
// Why: these registries have shipped malware many times, usually through a hijacked maintainer
// account publishing a poisoned version of a popular package. Most of them are spotted and pulled
// within hours or a few days. Waiting means Renovate never even creates a branch for such a
// version, so CI never installs it either. See README.md.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Renovate's own presets for npm, PyPI and crates.io. They also add a warning to PRs for the
  // update types the wait can't apply to (pin, replacement, lock file maintenance...), and tell
  // npm about the wait for indirect dependencies. They set 3 days; the rule below keeps 7.
  extends: ["security:minimumReleaseAgeNpm", "security:minimumReleaseAgePypi", "security:minimumReleaseAgeCrate"],
  packageRules: [
    {
      description: "Package registries: the same 7-day wait as everything else (the presets above set 3 days, and Go has no preset)",
      matchDatasources: ["npm", "pypi", "crate", "go"],
      minimumReleaseAge: "7 days",
    },
    {
      description: "Package registries: hold a version with no release date instead of raising it unchecked (default.json allows that for Docker registries)",
      matchDatasources: ["npm", "pypi", "crate", "go"],
      minimumReleaseAgeBehaviour: "timestamp-required",
    },
  ],
}
