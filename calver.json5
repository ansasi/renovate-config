// Never automerge dependencies with a date version (CalVer: 2026.02.07, 2026-02-07, 20260207,
// 2026.1023.0, RELEASE.2026-02-07T10-00-00Z...). No repo turns this back on. See README.md.
//
// Why: automerge relies on the update type. With SemVer (1.3.2) a minor or patch bump promises
// no breaking change. A date only says when it was released, so Renovate still calls
// 2026.02.07 -> 2026.03.01 a "minor" update even if it breaks everything.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Must be extended AFTER autoMerge.json5 and databases.json5 so these rules override them.
  packageRules: [
    {
      description: "Current version has a date in it: review it",
      matchCurrentVersion: "/(^|[^0-9])20\\d{2}([._-](0?[1-9]|1[0-2])([^0-9]|$)|[._-]?(0?[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])([^0-9]|$))/",
      addLabels: ["calver"],
      automerge: false,
    },
    {
      description: "New version has a date in it: review it",
      matchNewValue: "/(^|[^0-9])20\\d{2}([._-](0?[1-9]|1[0-2])([^0-9]|$)|[._-]?(0?[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])([^0-9]|$))/",
      addLabels: ["calver"],
      automerge: false,
    },
  ],
}
