// Never automerge dependencies with a date version (CalVer: 2026.02.07, 2026-02-07, 20260207,
// 2026.1023.0, RELEASE.2026-02-07T10-00-00Z...). No repo turns this back on. See README.md.
//
// Why: automerge relies on the update type. With SemVer (1.3.2) a minor or patch bump promises
// no breaking change. A date only says when it was released, so Renovate still calls
// 2026.02.07 -> 2026.03.01 a "minor" update even if it breaks everything.
//
// Container image tags can be any string, so for them the check also works the other way round:
// a tag that isn't a standard version (below) is never automerged either, with the `nonstandard`
// label. That catches the dates the patterns miss, and `latest`, `stable`, branch names, commit
// hashes and pre-releases. Other datasources (npm, PyPI, GitHub releases...) parse versions with
// their own strict schemes, so only the date patterns apply to them.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Must be extended AFTER autoMerge.json5 and databases.json5 so these rules override them.
  packageRules: [
    {
      description: "Current version has a date in it: review it",
      matchCurrentVersion: "/(^|[^0-9])20\\d{2}([._-](0?[1-9]|1[0-2])([^0-9]|$)|[._-]?(0?[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])([^0-9]|$))/",
      addLabels: ["calver"],
      automerge: false,
    },
    {
      description: "New version has a date in it: review it",
      matchNewValue: "/(^|[^0-9])20\\d{2}([._-](0?[1-9]|1[0-2])([^0-9]|$)|[._-]?(0?[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])([^0-9]|$))/",
      addLabels: ["calver"],
      automerge: false,
    },
    // A standard version: optional v, up to 3 digits before the first dot (so no 2026.11.11), up to
    // 3 more numbers without leading zeros (so no 25.04.1), and optional suffixes that start with a
    // letter (-alpine, -minimal-trixie, -alpine3.20, -ls12). For example 1.4.2, v2.0.1, 18,
    // 5.0.0.2941, 18.7-minimal-trixie.
    {
      description: "Image tag isn't a standard version (a date, latest, a branch, a hash...): review it",
      matchDatasources: ["docker"],
      matchCurrentValue: "!/^v?(0|[1-9][0-9]{0,2})(\\.(0|[1-9][0-9]*)){0,3}(-[a-z][a-z0-9.]*)*$/",
      addLabels: ["nonstandard"],
      automerge: false,
    },
    {
      description: "New image tag isn't a standard version: review it",
      matchDatasources: ["docker"],
      matchNewValue: "!/^v?(0|[1-9][0-9]{0,2})(\\.(0|[1-9][0-9]*)){0,3}(-[a-z][a-z0-9.]*)*$/",
      addLabels: ["nonstandard"],
      automerge: false,
    },
    {
      description: "Image tag is a pre-release (-beta, -rc1, -nightly...) or ends in a commit hash (-d48c4b5): review it",
      matchDatasources: ["docker"],
      matchNewValue: "/-((alpha|beta|rc|pre|preview|dev|nightly|snapshot|canary|edge|next|unstable)([0-9.]|-|$)|[0-9a-f]{7,40}(-|$))/",
      addLabels: ["nonstandard"],
      automerge: false,
    },
  ],
}
